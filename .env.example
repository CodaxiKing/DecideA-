# Supabase (Fase 5). Só a chave pública (anon/publishable); nunca a service_role.
# Local: rode `npm run db:start` e copie API_URL e ANON_KEY de `npx supabase status`.
# No emulador Android, use o IP da sua máquina na rede (não 127.0.0.1).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.0.10:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (Fase 7)
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
